digraph reachability {
  rankdir=LR;
  node [shape=box, fontname=monospace];
  "{p1=1, p4=1}" [style=filled, fillcolor="#dbe9ff"];
  "{p2=1, p4=1}" [];
  "{p1=1, p5=1}" [];
  "{p3=1}" [];
  "{p2=1, p5=1}" [style=filled, fillcolor="#ffd6d6", penwidth=2];
  "{p6=1}" [];
  "{p1=1, p4=1}" -> "{p2=1, p4=1}" [label="t1"];
  "{p1=1, p4=1}" -> "{p1=1, p5=1}" [label="t4"];
  "{p2=1, p4=1}" -> "{p3=1}" [label="t2"];
  "{p2=1, p4=1}" -> "{p2=1, p5=1}" [label="t4"];
  "{p1=1, p5=1}" -> "{p2=1, p5=1}" [label="t1"];
  "{p1=1, p5=1}" -> "{p6=1}" [label="t5"];
  "{p3=1}" -> "{p1=1, p4=1}" [label="t3"];
  "{p6=1}" -> "{p1=1, p4=1}" [label="t6"];
}
